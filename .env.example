# Copy to .env and fill in. Never commit .env.

# Which LLM powers /stylist: ollama (local, free), groq, gemini or anthropic.
STYLIST_PROVIDER=ollama
# Optional. Each provider has a sensible default (see app/config.py).
STYLIST_MODEL=

# Only the key for the provider you picked is needed.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. When set, clients must send it in the X-API-Key header.
SERVICE_API_KEY=
